  SELECT TOP 3 d.driver_name, COUNT(bwe.id) AS TotalBrakeEvents 
  FROM drivers d 
  INNER JOIN journeys j ON d.driver_id = j.driver_id 
  INNER JOIN brake_wear_events bwe ON j.trip_id = bwe.trip_id 
  GROUP BY d.driver_name 
  ORDER BY TotalBrakeEvents DESC
) AS driver_brake_events
