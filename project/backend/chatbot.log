  SELECT TOP 3 v.vehicle_name, COUNT(bwe.id) AS TotalBrakeEvents 
  FROM vehicles v 
  INNER JOIN brake_wear_events bwe ON v.id = bwe.vehicle_id 
  GROUP BY v.vehicle_name 
  ORDER BY TotalBrakeEvents DESC
