# Database Type: mssql or postgres
DB_TYPE=mssql

# Database Connection Settings (SQL Server / SSMS)
# DB_HOST=10.70.48.40,1433
# DB_HOST=192.168.5.33,1433
DB_HOST=abc
DB_NAME=abc
DB_TABLE=abc
 
# Set to 'yes' to use SSMS Windows Authentication (No username/password needed)
# Set to 'no' to use SQL Server Authentication (And fill user & password below)
DB_TRUSTED_CONNECTION=no

DB_USER=abc
DB_PASSWORD=123
USE_ML_MODEL=2
# Telemetry Replay Settings
TELEMETRY_REPLAY_INTERVAL_SEC=1
# If true: resumes from where it left off on refresh. If false: starts sending all historical alerts from the beginning (ID 0)
STREAM_RESUME_FROM_LATEST=false

GROQ_API_KEY=abc
LLM_MODEL=abc
ENABLE_MANUAL_REPLAY_CONTROL=abc

# Email Notification Settings
SMTP_SERVER=abc
SMTP_PORT=abc
SMTP_USERNAME=abc
SMTP_PASSWORD=abc
ALERT_EMAIL_RECIPIENT=abc
REMINDER_INTERVAL_MINUTES=abc

# WhatsApp Notification Settings
TWILIO_ACCOUNT_SID=abc
TWILIO_AUTH_TOKEN=abc
TWILIO_WHATSAPP_FROM=abc
ALERT_WHATSAPP_RECIPIENT=abc
